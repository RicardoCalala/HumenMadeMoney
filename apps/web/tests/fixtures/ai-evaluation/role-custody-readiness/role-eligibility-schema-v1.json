{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "role-eligibility-attestation-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordType", "schemaVersion", "protocolVersion", "eligibilityRecordId", "role", "candidateReferenceDigest", "attestedAt", "validUntil", "verifiedAt", "verifierAlias", "attestations", "outcome", "reasonCodes", "noAccessGranted", "participantCountersChanged", "releaseReviewersChanged", "genuineReleaseReviewsChanged", "hmmStatus", "testOnly"],
  "properties": {
    "recordType": { "const": "role_eligibility_attestation" },
    "schemaVersion": { "const": "role-eligibility-attestation-v1" },
    "protocolVersion": { "const": "role-custody-readiness-protocol-v1" },
    "eligibilityRecordId": { "type": "string", "format": "uuid" },
    "role": { "enum": ["KEY", "REC", "PRV", "RCV", "HDR", "ADJ", "OPR", "ADM"] },
    "candidateReferenceDigest": { "$ref": "#/$defs/digest" },
    "attestedAt": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "verifierAlias": { "$ref": "#/$defs/alias" },
    "attestations": { "type": "object" },
    "outcome": { "enum": ["eligible", "ineligible", "uncertain"] },
    "reasonCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_]{3,64}$" } },
    "noAccessGranted": { "const": true },
    "participantCountersChanged": { "const": 0 },
    "releaseReviewersChanged": { "const": 0 },
    "genuineReleaseReviewsChanged": { "const": 0 },
    "hmmStatus": { "const": "not_qualified" },
    "testOnly": { "type": "boolean" }
  },
  "allOf": [
    { "if": { "properties": { "role": { "const": "KEY" } } }, "then": { "properties": { "attestations": { "$ref": "#/$defs/KEY" } } } },
    { "if": { "properties": { "role": { "const": "REC" } } }, "then": { "properties": { "attestations": { "$ref": "#/$defs/REC" } } } },
    { "if": { "properties": { "role": { "const": "PRV" } } }, "then": { "properties": { "attestations": { "$ref": "#/$defs/PRV" } } } },
    { "if": { "properties": { "role": { "const": "RCV" } } }, "then": { "properties": { "attestations": { "$ref": "#/$defs/RCV" } } } },
    { "if": { "properties": { "role": { "const": "HDR" } } }, "then": { "properties": { "attestations": { "$ref": "#/$defs/HDR" } } } },
    { "if": { "properties": { "role": { "const": "ADJ" } } }, "then": { "properties": { "attestations": { "$ref": "#/$defs/ADJ" } } } },
    { "if": { "properties": { "role": { "const": "OPR" } } }, "then": { "properties": { "attestations": { "$ref": "#/$defs/OPR" } } } },
    { "if": { "properties": { "role": { "const": "ADM" } } }, "then": { "properties": { "attestations": { "$ref": "#/$defs/ADM" } } } }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "alias": { "type": "string", "pattern": "^(?:TST-)?(?:SCR|ADJ|OPR|ADM|KEY|REC|PRV|RCV|HDR)-[A-Z0-9]{8,32}$" },
    "KEY": { "$ref": "#/$defs/TWELVE_KEY" },
    "REC": { "$ref": "#/$defs/TWELVE_REC" },
    "PRV": { "$ref": "#/$defs/TWELVE_PRV" },
    "RCV": { "$ref": "#/$defs/TWELVE_RCV" },
    "HDR": { "$ref": "#/$defs/TEN_HDR" },
    "ADJ": { "$ref": "#/$defs/EIGHT_ADJ" },
    "OPR": { "$ref": "#/$defs/SIX_OPR" },
    "ADM": { "$ref": "#/$defs/SIX_ADM" },
    "TWELVE_KEY": { "type": "object", "additionalProperties": false, "required": ["KEY-01", "KEY-02", "KEY-03", "KEY-04", "KEY-05", "KEY-06", "KEY-07", "KEY-08", "KEY-09", "KEY-10", "KEY-11", "KEY-12"], "properties": { "KEY-01": { "const": true }, "KEY-02": { "const": true }, "KEY-03": { "const": true }, "KEY-04": { "const": true }, "KEY-05": { "const": true }, "KEY-06": { "const": true }, "KEY-07": { "const": true }, "KEY-08": { "const": true }, "KEY-09": { "const": true }, "KEY-10": { "const": true }, "KEY-11": { "const": true }, "KEY-12": { "const": true } } },
    "TWELVE_REC": { "type": "object", "additionalProperties": false, "required": ["REC-01", "REC-02", "REC-03", "REC-04", "REC-05", "REC-06", "REC-07", "REC-08", "REC-09", "REC-10", "REC-11", "REC-12"], "properties": { "REC-01": { "const": true }, "REC-02": { "const": true }, "REC-03": { "const": true }, "REC-04": { "const": true }, "REC-05": { "const": true }, "REC-06": { "const": true }, "REC-07": { "const": true }, "REC-08": { "const": true }, "REC-09": { "const": true }, "REC-10": { "const": true }, "REC-11": { "const": true }, "REC-12": { "const": true } } },
    "TWELVE_PRV": { "type": "object", "additionalProperties": false, "required": ["PRV-01", "PRV-02", "PRV-03", "PRV-04", "PRV-05", "PRV-06", "PRV-07", "PRV-08", "PRV-09", "PRV-10", "PRV-11", "PRV-12"], "properties": { "PRV-01": { "const": true }, "PRV-02": { "const": true }, "PRV-03": { "const": true }, "PRV-04": { "const": true }, "PRV-05": { "const": true }, "PRV-06": { "const": true }, "PRV-07": { "const": true }, "PRV-08": { "const": true }, "PRV-09": { "const": true }, "PRV-10": { "const": true }, "PRV-11": { "const": true }, "PRV-12": { "const": true } } },
    "TWELVE_RCV": { "type": "object", "additionalProperties": false, "required": ["RCV-01", "RCV-02", "RCV-03", "RCV-04", "RCV-05", "RCV-06", "RCV-07", "RCV-08", "RCV-09", "RCV-10", "RCV-11", "RCV-12"], "properties": { "RCV-01": { "const": true }, "RCV-02": { "const": true }, "RCV-03": { "const": true }, "RCV-04": { "const": true }, "RCV-05": { "const": true }, "RCV-06": { "const": true }, "RCV-07": { "const": true }, "RCV-08": { "const": true }, "RCV-09": { "const": true }, "RCV-10": { "const": true }, "RCV-11": { "const": true }, "RCV-12": { "const": true } } },
    "TEN_HDR": { "type": "object", "additionalProperties": false, "required": ["HDR-01", "HDR-02", "HDR-03", "HDR-04", "HDR-05", "HDR-06", "HDR-07", "HDR-08", "HDR-09", "HDR-10"], "properties": { "HDR-01": { "const": true }, "HDR-02": { "const": true }, "HDR-03": { "const": true }, "HDR-04": { "const": true }, "HDR-05": { "const": true }, "HDR-06": { "const": true }, "HDR-07": { "const": true }, "HDR-08": { "const": true }, "HDR-09": { "const": true }, "HDR-10": { "const": true } } },
    "EIGHT_ADJ": { "type": "object", "additionalProperties": false, "required": ["ADJ-01", "ADJ-02", "ADJ-03", "ADJ-04", "ADJ-05", "ADJ-06", "ADJ-07", "ADJ-08"], "properties": { "ADJ-01": { "const": true }, "ADJ-02": { "const": true }, "ADJ-03": { "const": true }, "ADJ-04": { "const": true }, "ADJ-05": { "const": true }, "ADJ-06": { "const": true }, "ADJ-07": { "const": true }, "ADJ-08": { "const": true } } },
    "SIX_OPR": { "type": "object", "additionalProperties": false, "required": ["OPR-01", "OPR-02", "OPR-03", "OPR-04", "OPR-05", "OPR-06"], "properties": { "OPR-01": { "const": true }, "OPR-02": { "const": true }, "OPR-03": { "const": true }, "OPR-04": { "const": true }, "OPR-05": { "const": true }, "OPR-06": { "const": true } } },
    "SIX_ADM": { "type": "object", "additionalProperties": false, "required": ["ADM-01", "ADM-02", "ADM-03", "ADM-04", "ADM-05", "ADM-06"], "properties": { "ADM-01": { "const": true }, "ADM-02": { "const": true }, "ADM-03": { "const": true }, "ADM-04": { "const": true }, "ADM-05": { "const": true }, "ADM-06": { "const": true } } }
  },
  "prohibitedFields": ["name", "email", "phone", "address", "employer", "biography", "diagnosis", "conflictNarrative", "path", "url", "provider", "credential", "passphrase", "secret", "apiKey", "fixtureText", "expectedLabel", "rawResponse", "score", "qualification"]
}
