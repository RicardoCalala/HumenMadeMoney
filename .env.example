# Local development only. Never use these placeholders for production.
DATABASE_URL="postgresql://hmm:hmm_local_only@127.0.0.1:5432/hmm_local?schema=public"
TEST_DATABASE_URL="postgresql://hmm:hmm_local_only@127.0.0.1:5432/hmm_test?schema=public"
HMM_PERSISTENCE_ADAPTER="in_memory"
HMM_AUTH_MODE="local_development"
HMM_CURSOR_SIGNING_SECRET="replace-with-a-long-random-local-value"
HMM_IDEMPOTENCY_RETENTION_HOURS="168"
HMM_SESSION_CLEANUP_BATCH_SIZE="100"

# Optional advisory model path. It remains disabled and unregistered by default.
# A development API key, if later approved, must be injected externally as
# HMM_AI_OPENAI_API_KEY and must never be added to this file.
HMM_AI_PROVIDER_ENABLED="false"
HMM_AI_PROVIDER=""
HMM_AI_OPENAI_ENABLED="false"
HMM_AI_MODEL_ENABLED="false"
HMM_AI_OPENAI_MODEL=""
HMM_AI_OPENAI_MODEL_ALLOWLIST=""
HMM_AI_KILL_SWITCH="false"
HMM_AI_ENVIRONMENT_KILL_SWITCH="false"
HMM_AI_OPENAI_KILL_SWITCH="false"
HMM_AI_MODEL_KILL_SWITCH="false"
