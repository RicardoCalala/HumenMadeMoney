    {"if":{"properties":{"role":{"const":"PRV"}},"required":["role"]},"then":{"properties":{"attestations":{"type":"object","propertyNames":{"pattern":"^PRV-(?:0[1-9]|1[0-2])$"}}}}},
    {"if":{"properties":{"outcome":{"const":"eligible"}},"required":["outcome"]},"then":{"properties":{"attestations":{"type":"object","minProperties":12,"maxProperties":12},"combinedAllTrue":{"const":true},"reasonCodes":{"type":"array","maxItems":0}}}},
    {"if":{"properties":{"combinedAllTrue":{"const":true}},"required":["combinedAllTrue"]},"then":{"properties":{"outcome":{"const":"eligible"}}}}
