{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orientation-validation-result-v1",
  "description": "Minimized pseudonymous append-only records; raw responses and identity mappings are out of scope.",
  "oneOf": [{ "$ref": "#/$defs/administration" }, { "$ref": "#/$defs/score" }, { "$ref": "#/$defs/adjudication" }, { "$ref": "#/$defs/operationalCheck" }],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "participant": { "type": "string", "pattern": "^VAL-[A-Z0-9]{8,32}$" },
    "administration": { "type": "object", "additionalProperties": false, "required": ["recordType", "recordId", "participantId", "operatorId", "contactOrdinal", "groupCode", "instrumentVersion", "orientationVersion", "orderVersion", "startedAt", "disposition", "responseDigest", "supportMode", "attestations", "testOnly"], "properties": { "recordType": { "const": "administration" }, "recordId": { "$ref": "#/$defs/uuid" }, "participantId": { "$ref": "#/$defs/participant" }, "operatorId": { "type": "string", "pattern": "^OPR-[A-Z0-9]{8,32}$" }, "contactOrdinal": { "type": "integer", "minimum": 1, "maximum": 16 }, "groupCode": { "enum": ["A", "B", "C", "D"] }, "instrumentVersion": { "const": "authority-comprehension-instrument-v1" }, "orientationVersion": { "const": "human-review-orientation-v2" }, "orderVersion": { "enum": ["order-a", "order-b"] }, "startedAt": { "type": "string", "format": "date-time" }, "disposition": { "enum": ["completed", "withdrawn", "technical_loss", "protocol_deviation"] }, "responseDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "supportMode": { "enum": ["none", "accessible_format", "assistive_technology", "breaks", "extra_time", "navigation_only"] }, "attestations": { "type": "object", "additionalProperties": false, "required": ["oneAttempt", "noCorrectiveFeedback", "noCoaching", "noDiagnosisRequired", "noPriorStudyExposure", "laterReleaseGatingIneligible", "pseudonymousOnly"], "properties": { "oneAttempt": { "const": true }, "noCorrectiveFeedback": { "const": true }, "noCoaching": { "const": true }, "noDiagnosisRequired": { "const": true }, "noPriorStudyExposure": { "const": true }, "laterReleaseGatingIneligible": { "const": true }, "pseudonymousOnly": { "const": true } } }, "testOnly": { "type": "boolean" } } },
    "score": { "type": "object", "additionalProperties": false, "required": ["recordType", "recordId", "administrationId", "participantId", "scorerId", "scoredAt", "rubricVersion", "labels", "attestations", "testOnly"], "properties": { "recordType": { "const": "score" }, "recordId": { "$ref": "#/$defs/uuid" }, "administrationId": { "$ref": "#/$defs/uuid" }, "participantId": { "$ref": "#/$defs/participant" }, "scorerId": { "type": "string", "pattern": "^SCR-[A-Z0-9]{8,32}$" }, "scoredAt": { "type": "string", "format": "date-time" }, "rubricVersion": { "const": "authority-comprehension-rubric-v1" }, "labels": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["itemId", "tag", "label"], "properties": { "itemId": { "type": "string" }, "tag": { "type": "string" }, "label": { "enum": ["demonstrated", "not_demonstrated", "ambiguous", "unsafe"] } } } }, "attestations": { "type": "object", "additionalProperties": false, "required": ["operatorSeparated", "independentlyScored", "otherScoreHidden", "identityAndGroupHidden", "frozenRubricOnly"], "properties": { "operatorSeparated": { "const": true }, "independentlyScored": { "const": true }, "otherScoreHidden": { "const": true }, "identityAndGroupHidden": { "const": true }, "frozenRubricOnly": { "const": true } } }, "testOnly": { "type": "boolean" } } },
    "adjudication": { "type": "object", "additionalProperties": false, "required": ["recordType", "recordId", "administrationId", "participantId", "adjudicatorId", "scorerRecordIds", "itemId", "tag", "finalLabel", "adjudicatedAt", "reasonCode", "attestations", "testOnly"], "properties": { "recordType": { "const": "adjudication" }, "recordId": { "$ref": "#/$defs/uuid" }, "administrationId": { "$ref": "#/$defs/uuid" }, "participantId": { "$ref": "#/$defs/participant" }, "adjudicatorId": { "type": "string", "pattern": "^ADJ-[A-Z0-9]{8,32}$" }, "scorerRecordIds": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/uuid" } }, "itemId": { "type": "string" }, "tag": { "type": "string" }, "finalLabel": { "enum": ["demonstrated", "not_demonstrated", "ambiguous", "unsafe"] }, "adjudicatedAt": { "type": "string", "format": "date-time" }, "reasonCode": { "enum": ["semantic_equivalence", "rubric_interpretation", "label_correction"] }, "attestations": { "type": "object", "additionalProperties": false, "required": ["independentOfOperatorAndScorers", "originalResponseOnly", "frozenRubricOnly", "noNewResponseOrCoaching", "cannotWaiveUnsafe"], "properties": { "independentOfOperatorAndScorers": { "const": true }, "originalResponseOnly": { "const": true }, "frozenRubricOnly": { "const": true }, "noNewResponseOrCoaching": { "const": true }, "cannotWaiveUnsafe": { "const": true } } }, "testOnly": { "type": "boolean" } } },
    "operationalCheck": { "type": "object", "additionalProperties": false, "required": ["recordType", "recordId", "check", "status", "checkedAt", "testOnly"], "properties": { "recordType": { "const": "operational_check" }, "recordId": { "$ref": "#/$defs/uuid" }, "check": { "enum": ["privacy_minimization", "identity_mapping_separation", "encrypted_backup_restore", "independent_head_digest", "network_and_credentials", "accessibility", "instrument_fidelity"] }, "status": { "enum": ["pass", "critical_failure"] }, "checkedAt": { "type": "string", "format": "date-time" }, "testOnly": { "type": "boolean" } } }
  },
  "prohibitedFields": ["name", "email", "phone", "employer", "jobTitle", "education", "diagnosis", "disability", "backgroundNarrative", "rawResponse", "identityMapping", "credential", "apiKey"]
}
