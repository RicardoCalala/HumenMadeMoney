{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "custody-topology-v1", "type": "object", "additionalProperties": false,
  "required": ["recordType", "schemaVersion", "protocolVersion", "topologyId", "approvedAt", "validUntil", "compartments", "primaryBackupControllerSeparated", "identityAliasSeparatelyControlled", "rawEncrypted", "ledgerMinimizedAppendOnly", "keyPresentationSeparatelyControlled", "incidentEvidenceIsolatedMinimized", "noGitOrProductionLocations", "noSecretValues", "testOnly", "topologyDigest"],
  "properties": {
    "recordType": { "const": "custody_topology" }, "schemaVersion": { "const": "custody-topology-v1" }, "protocolVersion": { "const": "role-custody-readiness-protocol-v1" }, "topologyId": { "type": "string", "format": "uuid" }, "approvedAt": { "type": "string", "format": "date-time" }, "validUntil": { "type": "string", "format": "date-time" },
    "compartments": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/compartment" } },
    "primaryBackupControllerSeparated": { "const": true }, "identityAliasSeparatelyControlled": { "const": true }, "rawEncrypted": { "const": true }, "ledgerMinimizedAppendOnly": { "const": true }, "keyPresentationSeparatelyControlled": { "const": true }, "incidentEvidenceIsolatedMinimized": { "const": true }, "noGitOrProductionLocations": { "const": true }, "noSecretValues": { "const": true }, "testOnly": { "type": "boolean" }, "topologyDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "alias": { "type": "string", "pattern": "^(?:TST-)?(?:SCR|ADJ|OPR|ADM|KEY|REC|PRV|RCV|HDR)-[A-Z0-9]{8,32}$" },
    "compartment": { "type": "object", "additionalProperties": false, "required": ["class", "locationRef", "controllerAlias", "administratorAlias", "storageTypeCode", "encryptionEvidenceDigest", "authenticationEvidenceDigest", "accessListDigest", "loggingEvidenceDigest", "retentionPolicyDigest", "deletionTriggerCode", "backupCovered", "separatelyControlled"], "properties": { "class": { "enum": ["IDMAP", "RAW", "LEDGER", "CAL", "PRES", "KEYS", "BACKUP", "INC"] }, "locationRef": { "type": "string", "pattern": "^LOC-[A-Z0-9]{12,40}$" }, "controllerAlias": { "$ref": "#/$defs/alias" }, "administratorAlias": { "$ref": "#/$defs/alias" }, "storageTypeCode": { "enum": ["encrypted_file_store", "encrypted_object_store", "append_only_store", "offline_encrypted_backup", "restricted_case_store"] }, "encryptionEvidenceDigest": { "$ref": "#/$defs/digest" }, "authenticationEvidenceDigest": { "$ref": "#/$defs/digest" }, "accessListDigest": { "$ref": "#/$defs/digest" }, "loggingEvidenceDigest": { "$ref": "#/$defs/digest" }, "retentionPolicyDigest": { "$ref": "#/$defs/digest" }, "deletionTriggerCode": { "type": "string", "pattern": "^[a-z0-9_]{3,64}$" }, "backupCovered": { "type": "boolean" }, "separatelyControlled": { "const": true } } }
  }, "prohibitedFields": ["actualPath", "url", "provider", "account", "identity", "credential", "passphrase", "secret", "apiKey", "content"]
}
