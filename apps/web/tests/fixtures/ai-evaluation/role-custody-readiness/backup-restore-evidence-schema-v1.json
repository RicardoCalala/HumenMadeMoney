{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "backup-restore-evidence-v1", "type": "object", "additionalProperties": false,
  "required": ["recordType", "schemaVersion", "protocolVersion", "restoreId", "startedAt", "completedAt", "validUntil", "recoveryOwnerAlias", "independentVerifierAlias", "topologyDigest", "procedureDigest", "sourceManifestDigest", "restoredManifestDigest", "sourceHeadDigest", "restoredHeadDigest", "coveredClasses", "recordCountExpected", "recordCountRestored", "splitControlVerified", "encryptedBackupVerified", "isolatedEmptyTarget", "nonOverwriteVerified", "permissionProfileVerified", "deletionHoldPropagationVerified", "exactDigestMatch", "cleanupVerified", "syntheticOrEmptyOnly", "noSecretValuesRecorded", "status", "reasonCodes", "networkRequests", "testOnly", "evidenceDigest"],
  "properties": {
    "recordType": { "const": "backup_restore_evidence" }, "schemaVersion": { "const": "backup-restore-evidence-v1" }, "protocolVersion": { "const": "role-custody-readiness-protocol-v1" }, "restoreId": { "type": "string", "format": "uuid" }, "startedAt": { "type": "string", "format": "date-time" }, "completedAt": { "type": "string", "format": "date-time" }, "validUntil": { "type": "string", "format": "date-time" }, "recoveryOwnerAlias": { "type": "string", "pattern": "^(?:TST-)?RCV-[A-Z0-9]{8,32}$" }, "independentVerifierAlias": { "type": "string", "pattern": "^(?:TST-)?(?:ADJ|OPR|ADM|KEY|REC|PRV|HDR)-[A-Z0-9]{8,32}$" },
    "topologyDigest": { "$ref": "#/$defs/digest" }, "procedureDigest": { "$ref": "#/$defs/digest" }, "sourceManifestDigest": { "$ref": "#/$defs/digest" }, "restoredManifestDigest": { "$ref": "#/$defs/digest" }, "sourceHeadDigest": { "$ref": "#/$defs/digest" }, "restoredHeadDigest": { "$ref": "#/$defs/digest" }, "coveredClasses": { "type": "array", "uniqueItems": true, "items": { "enum": ["IDMAP", "RAW", "LEDGER", "CAL", "PRES", "KEYS", "BACKUP", "INC"] } }, "recordCountExpected": { "type": "integer", "minimum": 0 }, "recordCountRestored": { "type": "integer", "minimum": 0 },
    "splitControlVerified": { "const": true }, "encryptedBackupVerified": { "const": true }, "isolatedEmptyTarget": { "const": true }, "nonOverwriteVerified": { "const": true }, "permissionProfileVerified": { "const": true }, "deletionHoldPropagationVerified": { "const": true }, "exactDigestMatch": { "const": true }, "cleanupVerified": { "const": true }, "syntheticOrEmptyOnly": { "const": true }, "noSecretValuesRecorded": { "const": true }, "status": { "const": "PASS" }, "reasonCodes": { "type": "array", "maxItems": 0 }, "networkRequests": { "const": 0 }, "testOnly": { "type": "boolean" }, "evidenceDigest": { "$ref": "#/$defs/digest" }
  }, "$defs": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "prohibitedFields": ["path", "url", "provider", "account", "credential", "passphrase", "secret", "factor", "apiKey", "content"]
}
