{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["DATABASE_URL", "HMM_AUTH_MODE", "HMM_CURSOR_SIGNING_SECRET", "HMM_IDEMPOTENCY_RETENTION_HOURS", "HMM_PERSISTENCE_ADAPTER", "HMM_SESSION_CLEANUP_BATCH_SIZE"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "HMM_AUTH_MODE", "HMM_CURSOR_SIGNING_SECRET", "HMM_IDEMPOTENCY_RETENTION_HOURS", "HMM_PERSISTENCE_ADAPTER", "HMM_SESSION_CLEANUP_BATCH_SIZE"]
    }
  }
}
