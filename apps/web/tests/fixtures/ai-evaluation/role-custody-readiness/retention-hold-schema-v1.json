{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "retention-hold-v1", "oneOf": [
    { "type": "object", "additionalProperties": false, "required": ["recordType", "schemaVersion", "policyId", "effectiveAt", "validUntil", "rules", "backupDeletionPropagationHours", "deletionExecutorAlias", "deletionVerifierAlias", "policyDigest", "testOnly"], "properties": { "recordType": { "const": "retention_policy" }, "schemaVersion": { "const": "retention-hold-v1" }, "policyId": { "type": "string", "format": "uuid" }, "effectiveAt": { "type": "string", "format": "date-time" }, "validUntil": { "type": "string", "format": "date-time" }, "rules": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["class", "triggerCode", "daysAfterTrigger", "prerequisites"], "properties": { "class": { "enum": ["IDMAP", "RAW", "LEDGER", "CAL", "PRES", "KEYS", "BACKUP", "INC", "ROLE_MAPPING", "AGGREGATE_REPORT", "ARTIFACT_MANIFEST", "HEAD_CONFIRMATION"] }, "triggerCode": { "type": "string" }, "daysAfterTrigger": { "type": "integer", "minimum": 1 }, "prerequisites": { "type": "array", "items": { "type": "string" } } } } }, "backupDeletionPropagationHours": { "type": "integer", "minimum": 1 }, "deletionExecutorAlias": { "type": "string" }, "deletionVerifierAlias": { "type": "string" }, "policyDigest": { "$ref": "#/$defs/digest" }, "testOnly": { "type": "boolean" } } },
    { "type": "object", "additionalProperties": false, "required": ["recordType", "schemaVersion", "holdId", "scope", "reasonCode", "ownerAlias", "approvingAuthorityAlias", "startedAt", "nextReviewAt", "releaseDeletionTrigger", "affectedDigests", "accessListDigest", "status", "releasedAt", "testOnly"], "properties": { "recordType": { "const": "retention_hold" }, "schemaVersion": { "const": "retention-hold-v1" }, "holdId": { "type": "string", "format": "uuid" }, "scope": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "reasonCode": { "type": "string" }, "ownerAlias": { "type": "string" }, "approvingAuthorityAlias": { "type": "string" }, "startedAt": { "type": "string", "format": "date-time" }, "nextReviewAt": { "type": "string", "format": "date-time" }, "releaseDeletionTrigger": { "type": "string" }, "affectedDigests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/digest" } }, "accessListDigest": { "$ref": "#/$defs/digest" }, "status": { "enum": ["active", "released"] }, "releasedAt": { "type": ["string", "null"], "format": "date-time" }, "testOnly": { "type": "boolean" } } }
  ], "$defs": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
