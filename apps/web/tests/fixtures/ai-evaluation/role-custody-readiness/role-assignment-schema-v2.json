{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"role-assignment-v2","type":"object","additionalProperties":false,
  "required":["recordType","schemaVersion","protocolVersion","assignmentId","role","alias","mappingRecordDigest","eligibilitySchemaVersion","eligibilityDigest","administrationDigest","accessProfileDigest","founderApprovalDigest","assignedAt","validFrom","validUntil","status","accessEnabled","revocationReasonCode","revokedAt","assignmentDigest"],
