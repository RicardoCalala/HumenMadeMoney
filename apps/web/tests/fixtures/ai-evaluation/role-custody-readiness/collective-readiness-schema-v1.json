rol" }, "appendOnlyChain": { "$ref": "#/$defs/control" }, "correctionSemantics": { "$ref": "#/$defs/control" }, "independentHead": { "$ref": "#/$defs/control" }, "retentionDeletion": { "$ref": "#/$defs/control" }, "holdProcedure": { "$ref": "#/$defs/control" }, "incidentRoute": { "$ref": "#/$defs/control" }, "offlineValidation": { "$ref": "#/$defs/control" }, "zeroNetwork": { "$ref": "#/$defs/control" }, "noQualificationEffect": { "$ref": "#/$defs/control" } } }, "openIncidents": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "conflictingEvidence": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "staleEvidence": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "participantCounters": { "type": "object", "additionalProperties": false, "required": ["contacted", "enrolled", "A", "B", "C", "D"], "properties": { "contacted": { "const": 0 }, "enrolled": { "const": 0 }, "A": { "const": 0 }, "B": { "const": 0 }, "C": { "const": 0 }, "D": { "const": 0 } } }, "releaseGate": { "type": "object", "additionalProperties": false, "required": ["reviewers", "genuineReviews", "hmmStatus"], "properties": { "reviewers": { "const": 0 }, "genuineReviews": { "const": 0 }, "hmmStatus": { "const": "not_qualified" } } },
