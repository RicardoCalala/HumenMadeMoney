{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts tests/**/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "db:reset:test": "node --experimental-strip-types scripts/reset-test-database.ts",
    "test:postgres": "node --test --test-concurrency=1 --experimental-strip-types tests/postgres/**/*.test.ts",
    "mcp:stdio": "node --experimental-strip-types scripts/mcp-server.ts",
    "ai:smoke:dry-run": "node --experimental-strip-types scripts/openai-smoke-dry-run.ts",
    "ai:smoke:authorize": "node --experimental-strip-types scripts/openai-smoke-authorize.ts",
    "ai:browser:authorize": "node --experimental-strip-types scripts/openai-browser-authorize.ts",
    "ai:smoke:preflight": "node --experimental-strip-types scripts/openai-smoke-preflight.ts",
    "ai:smoke:live": "node --experimental-strip-types scripts/openai-smoke-live.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/client": "6.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "6.19.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.20.0"
}
