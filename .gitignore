# General .gitignore for Human Made Money

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-lock.yaml
package-lock.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
venv/
.env
.env.*

# macOS
.DS_Store

# Logs
logs/
*.log

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Coverage
coverage/
.coverage

# Temporary files
*.tmp
*.swp

# Docker
docker-compose.override.yml

# Secrets
.secret

# Misc
/public/uploads/

