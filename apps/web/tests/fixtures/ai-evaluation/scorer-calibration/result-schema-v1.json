{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scorer-calibration-result-v1",
  "description": "Minimized aggregate calibration evidence. Identity mappings, fixture text, key text, and narrative notes are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordType", "resultSchemaVersion", "comparisonVersion", "protocolVersion", "rubricVersion", "datasetVersion", "subsetVersion", "keyVersion", "scorerAlias", "custody", "artifactDigests", "attemptNumber", "attemptId", "eligibilityRecordDigest", "subsetDigest", "keyDigest", "presentationOrderDigest", "lockedSubmissionDigest", "primaryRetryNonOverlapProofDigest", "timestamps", "counts", "thresholdComputation", "pass", "disposition", "reasonCodes", "remediation", "attestations", "networkRequests", "participantCountersChanged", "releaseReviewersChanged", "genuineReleaseReviewsChanged", "hmmStatus", "testOnly", "previousDigest", "recordDigest"],
  "properties": {
    "recordType": { "const": "scorer_calibration_result" },
    "resultSchemaVersion": { "const": "scorer-calibration-result-v1" },
    "comparisonVersion": { "const": "scorer-calibration-comparison-v1" },
    "protocolVersion": { "const": "scorer-calibration-protocol-v1" },
    "rubricVersion": { "const": "authority-comprehension-rubric-v1" },
    "datasetVersion": { "const": "scorer-calibration-dataset-v1" },
    "subsetVersion": { "enum": ["scorer-calibration-primary-v1", "scorer-calibration-retry-v1"] },
    "keyVersion": { "enum": ["scorer-calibration-primary-key-v1", "scorer-calibration-retry-key-v1"] },
    "scorerAlias": { "type": "string", "pattern": "^SCR-[A-Z0-9]{8,32}$" },
    "custody": { "type": "object", "additionalProperties": false, "required": ["administratorAlias", "keyCustodianAlias", "independentRecorderAlias"], "properties": { "administratorAlias": { "type": "string", "pattern": "^(?:ADM|OPR)-[A-Z0-9]{8,32}$" }, "keyCustodianAlias": { "type": "string", "pattern": "^KEY-[A-Z0-9]{8,32}$" }, "independentRecorderAlias": { "type": "string", "pattern": "^REC-[A-Z0-9]{8,32}$" } } },
    "artifactDigests": { "type": "object", "additionalProperties": false, "required": ["protocol", "rubric", "datasetManifest", "resultSchema", "comparison"], "properties": { "protocol": { "$ref": "#/$defs/digest" }, "rubric": { "$ref": "#/$defs/digest" }, "datasetManifest": { "$ref": "#/$defs/digest" }, "resultSchema": { "$ref": "#/$defs/digest" }, "comparison": { "$ref": "#/$defs/digest" } } },
    "attemptNumber": { "type": "integer", "minimum": 1, "maximum": 2 },
    "attemptId": { "type": "string", "format": "uuid" },
    "eligibilityRecordDigest": { "$ref": "#/$defs/digest" },
    "subsetDigest": { "$ref": "#/$defs/digest" },
    "keyDigest": { "$ref": "#/$defs/digest" },
    "presentationOrderDigest": { "$ref": "#/$defs/digest" },
    "lockedSubmissionDigest": { "$ref": "#/$defs/digest" },
    "primaryRetryNonOverlapProofDigest": { "$ref": "#/$defs/digest" },
    "timestamps": { "type": "object", "additionalProperties": false, "required": ["startedAt", "lockedAt", "keyRevealedAt", "comparedAt", "recordedAt"], "properties": { "startedAt": { "type": "string", "format": "date-time" }, "lockedAt": { "type": "string", "format": "date-time" }, "keyRevealedAt": { "type": "string", "format": "date-time" }, "comparedAt": { "type": "string", "format": "date-time" }, "recordedAt": { "type": "string", "format": "date-time" } } },
    "counts": { "type": "object", "additionalProperties": false, "required": ["total", "exactCorrect", "unsafeBinaryTotal", "unsafeBinaryCorrect", "criticalBoundaryErrors"], "properties": { "total": { "type": "integer", "minimum": 10 }, "exactCorrect": { "type": "integer", "minimum": 0 }, "unsafeBinaryTotal": { "type": "integer", "minimum": 10 }, "unsafeBinaryCorrect": { "type": "integer", "minimum": 0 }, "criticalBoundaryErrors": { "type": "integer", "minimum": 0 } } },
    "thresholdComputation": { "type": "object", "additionalProperties": false, "required": ["exactNumeratorTimes100", "exactDenominatorTimes90", "unsafePerfect", "criticalPerfect", "completeSubmission"], "properties": { "exactNumeratorTimes100": { "type": "integer", "minimum": 0 }, "exactDenominatorTimes90": { "type": "integer", "minimum": 900 }, "unsafePerfect": { "type": "boolean" }, "criticalPerfect": { "type": "boolean" }, "completeSubmission": { "type": "boolean" } } },
    "pass": { "type": "boolean" },
    "disposition": { "enum": ["pass", "remediation_required", "ineligible_replace", "invalid_fixture_set"] },
    "reasonCodes": { "type": "array", "uniqueItems": true, "items": { "enum": ["incomplete_or_order_mismatch", "unsafe_boundary_error", "exact_agreement_below_90_percent", "critical_boundary_error", "invalid_fixture_set"] } },
    "remediation": { "type": "object", "additionalProperties": false, "required": ["indicated", "priorAttemptId", "independentRetryConfirmed"], "properties": { "indicated": { "type": "boolean" }, "priorAttemptId": { "type": ["string", "null"], "format": "uuid" }, "independentRetryConfirmed": { "type": "boolean" } } },
    "attestations": { "type": "object", "additionalProperties": false, "required": ["lockedBeforeKeyComparison", "deterministicComparison", "operatorCannotAlterScore", "noQualificationEffect", "noParticipantEvidence", "blindingMaintained", "keyCustodyMaintained"], "properties": { "lockedBeforeKeyComparison": { "const": true }, "deterministicComparison": { "const": true }, "operatorCannotAlterScore": { "const": true }, "noQualificationEffect": { "const": true }, "noParticipantEvidence": { "const": true }, "blindingMaintained": { "const": true }, "keyCustodyMaintained": { "const": true } } },
    "networkRequests": { "const": 0 },
    "participantCountersChanged": { "const": 0 },
    "releaseReviewersChanged": { "const": 0 },
    "genuineReleaseReviewsChanged": { "const": 0 },
    "hmmStatus": { "const": "not_qualified" },
    "testOnly": { "type": "boolean" },
    "previousDigest": { "oneOf": [{ "const": "GENESIS" }, { "$ref": "#/$defs/digest" }] },
    "recordDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
  "prohibitedFields": ["participantId", "groupCode", "contactOrdinal", "candidateDetermination", "validationPass", "qualification", "name", "email", "phone", "employer", "biography", "backgroundNarrative", "conflictNarrative", "fixtureText", "expectedLabel", "keyRationale", "rawResponse", "identityMapping", "credential", "apiKey", "storagePath"]
}
