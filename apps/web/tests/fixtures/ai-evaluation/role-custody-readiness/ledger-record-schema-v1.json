{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "role-custody-ledger-v1", "oneOf": [
    { "$ref": "#/$defs/event" }, { "$ref": "#/$defs/correction" }, { "$ref": "#/$defs/incident" }, { "$ref": "#/$defs/head" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "base": { "type": "object", "properties": { "schemaVersion": { "const": "role-custody-ledger-v1" }, "recordId": { "type": "string", "format": "uuid" }, "occurredAt": { "type": "string", "format": "date-time" }, "actorAlias": { "type": "string", "pattern": "^(?:TST-)?(?:ADJ|OPR|ADM|KEY|REC|PRV|RCV|HDR)-[A-Z0-9]{8,32}$" }, "testOnly": { "type": "boolean" }, "previousDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "const": "GENESIS:role-custody-ledger-v1" }] }, "recordDigest": { "$ref": "#/$defs/digest" } } },
    "event": { "type": "object", "additionalProperties": false, "required": ["recordType", "schemaVersion", "recordId", "occurredAt", "actorAlias", "eventCode", "sourceDigests", "incidentId", "testOnly", "previousDigest", "recordDigest"], "properties": { "recordType": { "enum": ["role_event", "custody_event", "readiness_event", "deletion_tombstone"] }, "schemaVersion": { "const": "role-custody-ledger-v1" }, "recordId": { "type": "string", "format": "uuid" }, "occurredAt": { "type": "string", "format": "date-time" }, "actorAlias": { "type": "string" }, "eventCode": { "type": "string" }, "sourceDigests": { "type": "array", "items": { "$ref": "#/$defs/digest" } }, "incidentId": { "type": ["string", "null"] }, "testOnly": { "type": "boolean" }, "previousDigest": {}, "recordDigest": { "$ref": "#/$defs/digest" } } },
    "correction": { "type": "object", "additionalProperties": false, "required": ["recordType", "schemaVersion", "recordId", "occurredAt", "actorAlias", "targetRecordId", "targetRecordDigest", "reasonCode", "correctedClosedFields", "authorizationDigest", "rawSourceDigestUnchanged", "incidentId", "testOnly", "previousDigest", "recordDigest"], "properties": { "recordType": { "const": "correction" }, "schemaVersion": { "const": "role-custody-ledger-v1" }, "recordId": { "type": "string", "format": "uuid" }, "occurredAt": { "type": "string", "format": "date-time" }, "actorAlias": { "type": "string" }, "targetRecordId": { "type": "string", "format": "uuid" }, "targetRecordDigest": { "$ref": "#/$defs/digest" }, "reasonCode": { "type": "string" }, "correctedClosedFields": { "type": "object" }, "authorizationDigest": { "$ref": "#/$defs/digest" }, "rawSourceDigestUnchanged": { "const": true }, "incidentId": { "type": ["string", "null"] }, "testOnly": { "type": "boolean" }, "previousDigest": {}, "recordDigest": { "$ref": "#/$defs/digest" } } },
    "incident": { "type": "object", "additionalProperties": false, "required": ["recordType", "schemaVersion", "recordId", "occurredAt", "actorAlias", "incidentId", "incidentTypeCode", "severityCode", "affectedDigests", "affectedClasses", "containmentCode", "dispositionCode", "holdId", "testOnly", "previousDigest", "recordDigest"], "properties": { "recordType": { "const": "incident" }, "schemaVersion": { "const": "role-custody-ledger-v1" }, "recordId": { "type": "string", "format": "uuid" }, "occurredAt": { "type": "string", "format": "date-time" }, "actorAlias": { "type": "string" }, "incidentId": { "type": "string" }, "incidentTypeCode": { "type": "string" }, "severityCode": { "enum": ["low", "moderate", "high", "critical"] }, "affectedDigests": { "type": "array", "items": { "$ref": "#/$defs/digest" } }, "affectedClasses": { "type": "array", "items": { "enum": ["IDMAP", "RAW", "LEDGER", "CAL", "PRES", "KEYS", "BACKUP", "INC"] } }, "containmentCode": { "type": "string" }, "dispositionCode": { "type": "string" }, "holdId": { "type": ["string", "null"] }, "testOnly": { "type": "boolean" }, "previousDigest": {}, "recordDigest": { "$ref": "#/$defs/digest" } } },
    "head": { "type": "object", "additionalProperties": false, "required": ["recordType", "schemaVersion", "confirmationId", "recorderAlias", "observedAt", "genesis", "recordCount", "recomputedHead", "expectedHead", "correctionSummaryDigest", "incidentSummaryDigest", "previousConfirmationDigest", "status", "testOnly", "confirmationDigest"], "properties": { "recordType": { "const": "final_head_confirmation" }, "schemaVersion": { "const": "role-custody-ledger-v1" }, "confirmationId": { "type": "string", "format": "uuid" }, "recorderAlias": { "type": "string", "pattern": "^(?:TST-)?HDR-[A-Z0-9]{8,32}$" }, "observedAt": { "type": "string", "format": "date-time" }, "genesis": { "const": "GENESIS:role-custody-ledger-v1" }, "recordCount": { "type": "integer", "minimum": 0 }, "recomputedHead": {}, "expectedHead": {}, "correctionSummaryDigest": { "$ref": "#/$defs/digest" }, "incidentSummaryDigest": { "$ref": "#/$defs/digest" }, "previousConfirmationDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "status": { "enum": ["confirmed", "mismatch"] }, "testOnly": { "type": "boolean" }, "confirmationDigest": { "$ref": "#/$defs/digest" } } }
  }, "prohibitedFields": ["name", "contact", "identity", "path", "credential", "secret", "fixtureText", "expectedLabel", "rawResponse", "score", "freeTextNarrative"]
}
